<manifest version="1.0" type="device">
    <hal format="aidl">
        <name>android.hardware.thermal</name>
        <version>2</version>
        <fqname>IThermal/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.qti.hardware.agm</name>
        <version>1</version>
        <fqname>IAGM/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.qti.hardware.pal</name>
        <version>1</version>
        <fqname>IPAL/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.qti.hardware.paleventnotifier</name>
        <version>2</version>
        <fqname>IPALEventNotifier/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.qti.hardware.ListenSoundModelAidl</name>
        <version>1</version>
        <fqname>IListenSoundModel/default</fqname>
    </hal>
    <hal format="native">
        <name>mapper</name>
        <version>5.0</version>
        <interface>
            <instance>qti</instance>
        </interface>
    </hal>
    <hal format="aidl">
        <name>android.hardware.memtrack</name>
        <fqname>IMemtrack/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.soundtrigger3</name>
        <version>1</version>
        <fqname>ISoundTriggerHw/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.graphics.allocator</name>
        <version>2</version>
        <interface>
            <name>IAllocator</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl">
        <name>vendor.qti.hardware.display.demura</name>
        <version>1</version>
        <fqname>IDemuraFileFinder/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.graphics.composer3</name>
        <version>3</version>
        <fqname>IComposer/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.qti.hardware.display.color</name>
        <version>1</version>
        <fqname>IDisplayColor/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.qti.hardware.display.postproc</name>
        <version>1</version>
        <fqname>IDisplayPostproc/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.qti.hardware.display.config</name>
        <version>12</version>
        <fqname>IDisplayConfig/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.qti.hardware.display.aiqe</name>
        <version>2</version>
        <fqname>IDisplayAiqe/default</fqname>
    </hal>
</manifest>
