// fstab.qcom lives in the device tree rather than being pulled in as a blob:
// it is the one vendor config file this port actually has to change (the stock
// copy mounts dataext and vm-bootsys, neither of which this build produces an
// image for). proprietary-files.txt therefore skips vendor/etc/fstab.qcom, so
// there is exactly one rule installing it.
//
// TARGET_RECOVERY_FSTAB in BoardConfig.mk points at the same source file, which
// is how recovery gets its copy.
//
// ⚠️ This module alone is NOT enough to boot. It only produces
// /vendor/etc/fstab.qcom, and first-stage init cannot read that — /vendor is
// exactly what it is about to mount. fs_mgr looks in
//   /odm/etc/fstab.* /vendor/etc/fstab.* /system/etc/fstab.*
//   /first_stage_ramdisk/system/etc/fstab.* /fstab.* /first_stage_ramdisk/fstab.*
// (system/core/fs_mgr/libfstab/fstab.cpp, GetFstabPath), and on this device the
// only one that exists that early is the vendor ramdisk copy — the stock
// vendor_boot ramdisk carries first_stage_ramdisk/fstab.qcom for that reason.
// There is no device-tree fallback either: /proc/device-tree/firmware/android/
// does not exist on this unit (checked on the running device).
// device.mk has the matching PRODUCT_COPY_FILES; the two go together.
prebuilt_etc {
    name: "fstab.qcom",
    src: "etc/fstab.qcom",
    vendor: true,
}

// Recovery does not mount /vendor, so nothing under vendor/etc/init/ is read
// there -- in particular init.target.rc, which is what creates
// /dev/block/bootdevice during a normal boot. Without this file recovery has no
// bootdevice symlink (so most of fstab.qcom fails) and no USB (so no
// `adb sideload` and no fastbootd).
//
// `recovery: true` + `sub_dir: "init"` puts it at
// /system/etc/init/init.recovery.qcom.rc inside the recovery ramdisk, which
// init picks up via parser.ParseConfig("/system/etc/init")
// (system/core/init/init.cpp:347). The whole directory is parsed, so the
// filename is conventional rather than load-bearing.
prebuilt_etc {
    name: "init.recovery.qcom.rc",
    src: "etc/init.recovery.qcom.rc",
    sub_dir: "init",
    recovery: true,
}
