# Verified against the running device with `ls -Z`: every file directly under
# soc:lenovo_kb/ carries sysfs_kb, except wakeup/, which the kernel's own
# wakeup-source labelling claims as sysfs_wakeup. The order matters — the more
# specific wakeup entry has to come after the directory entry.
genfscon sysfs /devices/platform/soc/soc:lenovo_kb            u:object_r:sysfs_kb:s0
genfscon sysfs /devices/platform/soc/soc:lenovo_kb/wakeup      u:object_r:sysfs_wakeup:s0

# The stylus and folio knobs. Stock leaves these as plain "proc" and lets its
# touchscreen HAL write any proc file; labelling them lets that HAL be granted
# these four alone (see hal_lenovo.te).
genfscon proc /pen_type                                        u:object_r:proc_lenovo_pen:s0
genfscon proc /pen_attached                                    u:object_r:proc_lenovo_pen:s0
genfscon proc /pen_wakeup_mode                                 u:object_r:proc_lenovo_pen:s0
genfscon proc /folio_case_mode                                 u:object_r:proc_lenovo_pen:s0

# The other eight /proc nodes the touchscreen HAL's .rc chowns. See file.te.
genfscon proc /panel_direction                                 u:object_r:proc_lenovo_touch:s0
genfscon proc /game_mode                                       u:object_r:proc_lenovo_touch:s0
genfscon proc /game_edge                                       u:object_r:proc_lenovo_touch:s0
genfscon proc /edge_grid_zone                                  u:object_r:proc_lenovo_touch:s0
genfscon proc /report_threshold                                u:object_r:proc_lenovo_touch:s0
genfscon proc /HighReportRate                                  u:object_r:proc_lenovo_touch:s0
genfscon proc /haptics                                         u:object_r:proc_lenovo_touch:s0
genfscon proc /gesture_control                                 u:object_r:proc_lenovo_touch:s0
