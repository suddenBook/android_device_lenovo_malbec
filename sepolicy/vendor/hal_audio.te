# Audio HAL — access it needs that neither AOSP nor the QTI vendor policy grants.
#
# Every rule here comes from a denial measured on a booted device
# (work/s15/boot1, 240 s from t=0), not from stock's policy or from guessing.
# The build is permissive today, so none of these break anything yet; they are
# written now because a permissive boot is the only place they can be observed,
# and because "it works, just with a denial" is exactly the state that turns
# into a silent regression the day enforcing is switched on.

#####################################
# Awinic smart-amplifier calibration.
#
# 51 of the 72 denials in that boot were this one path:
#
#   avc: denied { read open } name="aw_cali.bin"
#        scontext=u:r:hal_audio_default:s0
#        tcontext=u:object_r:mnt_vendor_file:s0 tclass=file
#
# /mnt/vendor/persist/factory/audio/aw_cali.bin is the per-unit Rdc/f0
# calibration for the four AW88461 amplifiers, written once on the production
# line by /vendor/bin/aw882xx_cali (an argv tool, not a service — nothing on the
# device ever rewrites it). This unit's values, read session 25:
# Re 6798 / 7081 / 6952 / 7094 mOhm and f0 589 / 581 / 563 / 562 Hz, all inside
# the driver's 4000-30000 mOhm window.
#
# ⚠️ Two corrections, session 25.
#
# (a) "...which is why the binary itself is not shipped" is out of date —
# `aw882xx_cali` IS shipped now (proprietary-files.txt, 85,216 B), added later
# with its own justification. The sentence contradicted the tree.
#
# (b) The causal claim below is not established. This block said the missing
# grant is why the amplifiers run uncalibrated, citing
# `aw_check_dsp_ready: rx topo id is 0x0` and the four `aw882xx_dev_init_cali_re`
# errors. Those errors are real and still present WITH the grant in place — see
# OPEN-ISSUES.md #65, which established that every audio configuration file we
# ship is byte-identical to stock's, that nothing on either side loads the
# calibration at boot, and that the topo-id 0 comes from the ADSP graph not
# carrying the Awinic module. **The grant is still correct** (PAL does open the
# path and a denial here would be a real one), but it is not the fix for those
# four errors, and reading it as one has cost one session already.
#
# Rather than granting the whole of mnt_vendor_file (which is every persist
# subdirectory, including the Bluetooth and Wi-Fi MAC blobs and the RPMB-adjacent
# secnvm), the directory gets its own type in file_contexts and only that is
# granted — the same shape the tree already uses for vendor_persist_bluetooth_file.
#
# init.target.rc:158-162 creates and chowns the directory, so it exists before
# the HAL starts; the label has to be in file_contexts before first boot because
# nothing restorecons it afterwards.
allow hal_audio_default vendor_persist_audio_file:dir search;
allow hal_audio_default vendor_persist_audio_file:file r_file_perms;

#####################################
# Amplifier identification.
#
#   avc: denied { read open } name="aw882xx_chipid"
#        scontext=u:r:hal_audio_default:s0 tcontext=u:object_r:sysfs:s0
#
# aw882xx.ko exports the detected chip id per i2c device. PAL reads it to pick
# the amplifier's parameter set. Same treatment as the calibration file: the
# node gets its own type via genfs_contexts rather than opening all of sysfs to
# the audio HAL.
allow hal_audio_default sysfs_awinic:dir search;
allow hal_audio_default sysfs_awinic:file r_file_perms;

#####################################
# Dolby DMS: nothing here any more, and that is the point.
#
# This block used to carry three rules tying hal_audio_default to
# vendor.dolby.dms.service:
#
#     binder_call(hal_audio_default, hal_aidl_dms_default)
#     binder_call(hal_aidl_dms_default, hal_audio_default)
#     allow hal_audio_default hal_aidl_dms_service:service_manager find;
#
# They existed because the DAP effect ran INSIDE the audio HAL process and
# talked to DMS for profile and endpoint state. Dolby Atmos was removed in
# session 19 -- libswdapaidl.so and its declarations are gone, see the
# audio_effects_config.xml fixup in extract-files.py -- so that edge can no
# longer occur and all three rules are dead.
#
# The third one is worth naming because it was hard-won: binder_call does NOT
# grant service_manager find, so the first two described an edge the audio HAL
# could never reach. Retired on purpose, not lost.
#
# ⚠️ The DMS SERVICE ITSELF STAYS, and an audit that reads this file alone will
# conclude otherwise. Measured on the running device:
#
#     1605 /vendor/bin/hw/vendor.dolby.dms.service                    u:r:hal_aidl_dms_default:s0
#     1616 /vendor/bin/hw/vendor.dolby.media.c2-default-service-dax   u:r:mediacodec:s0
#
# and pid 1616 has libdmshal.so mapped with no Dolby effect anywhere in the
# image. That is the AC3 / E-AC3 / AC4 decoder service, which the owner requires
# and for which AOSP ships no replacement. Its rules are in
# hal_third_party.te:62-63 (binder_call(mediacodec, hal_aidl_dms_default) plus
# the service_manager find) and they are the ones that matter now.
#
# Deleting DMS along with the effects would have cost every Dolby soundtrack --
# the same trap as libdmshal.so itself, which the effects and the decoders
# share.

#####################################
# Not granted, deliberately:
#
#   avc: denied { read open } scontext=u:r:hal_audio_default:s0
#        tcontext=u:object_r:debugfs:s0 tclass=dir
#
# That is the HAL opening /sys/kernel/debug to look for ADSP trace nodes. It is
# a diagnostic path, it fails closed with one log line, and granting a vendor
# HAL a directory read over all of debugfs to gain nothing is the wrong trade.
# dontaudit rather than allow, so the noise goes away without the access.
dontaudit hal_audio_default debugfs:dir { read open search };
