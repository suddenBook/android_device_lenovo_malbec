    <!-- If this is true, the screen will come on when you unplug usb/power/whatever. -->
    <bool name="config_unplugTurnsOnScreen">true</bool>

    <!-- ================================================================== -->
    <!-- Doze / Always-On Display                                           -->
    <!-- ================================================================== -->

    <!-- Without this the entire doze subsystem is inert, and the omission is
         silent. AOSP's default is the empty string
         (frameworks/base/core/res/res/values/config.xml:2932) and nothing in
         vendor/, device/ or packages/ sets it. The chain:
         AmbientDisplayConfiguration.ambientDisplayAvailable() is
         !isEmpty(config_dozeComponent) -> false, so
         pulseOnNotificationAvailable() is false and every doze feature is
         disabled; DreamManagerService then gets a null ComponentName and
         DozeService is never bound.

         This tree was already self-inconsistent about it: config_screenBrightnessDoze
         above cites DozeParameters.java, which is code inside DozeService,
         a service that never ran. Both stock RROs decode to exactly this value,
         and so do both peer trees. -->
    <string name="config_dozeComponent" translatable="false">com.android.systemui/com.android.systemui.doze.DozeService</string>

    <!-- ================================================================== -->
    <!-- Colour modes                                                       -->
    <!-- ================================================================== -->

    <!-- AOSP's default is an EMPTY array (core/res/res/values/config.xml:1079-1085),
         which makes ColorDisplayService.isColorModeAvailable() always false and
         leaves colorMode at NOT_SET — so Settings > Display > Colors vanishes
         entirely. So an override is needed; the question is which values.

         The four AOSP modes, and only those:
             0 NATURAL   1 BOOSTED   2 SATURATED   3 AUTOMATIC (shown as "Adaptive")

         ⚠️ This used to also list the ten vendor-range modes 256-265
         (VENDOR_COLOR_MODE_RANGE_MIN = 256), copied from stock. The owner
         reported the symptom precisely: those entries appear in Settings with
         NO NAME, and selecting one does nothing. Both halves are explained, and
         neither is fixable from a device overlay:

           - No name. Settings takes the list of modes from
             com.android.internal.R.array.config_availableColorModes
             (ColorModeUtils.kt:66) but takes the NAMES from its own
             Settings/res/values/config.xml:625-640, which defines exactly four
             values: 0,1,2,3. getColorModeMapping() returns a map built from
             those, so colorModesToSummaries.get(256) is null and
             ColorModePreferenceFragment.getCandidates() adds a candidate with a
             null title.
           - No effect. DisplayTransformManager.java:282-286 passes a vendor
             mode straight through to setDisplayColor(colorMode), which is
             SurfaceFlinger binder transaction 1023, and
             SurfaceFlinger.cpp:7255-7256 does
                 mDisplayColorSetting = static_cast<DisplayColorSetting>(value)
             DisplayColorSetting only has MANAGED/UNMANAGED/ENHANCED, so 256-265
             cast to an out-of-range value that no branch matches. These modes
             exist only in QTI's SurfaceFlinger fork
             (libsurfaceflingerextension), and PixelOS builds AOSP's.
             Independently confirmed on the running device: SurfaceFlinger
             reports exactly three supported colour modes — NATIVE, SRGB,
             DISPLAY_P3 — with no vendor entries at all.

         2 (SATURATED) is ADDED, having been missing before. It is the one mode
         with a guaranteed visible effect: DisplayTransformManager maps it to
         DISPLAY_COLOR_UNMANAGED, i.e. render straight to the panel's native
         gamut with no colour management. -->
    <integer-array name="config_availableColorModes">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
    </integer-array>

    <!-- Three values the factory ROM sets through RROs on the *product*
         partition, which PixelOS replaces. Nothing warns when they disappear:
         each one silently falls back to the AOSP default and the feature just
         behaves differently. Recovered by dumping every stock RRO that targets
         `android` with aapt2 and diffing against the built framework-res.apk
         (which already includes the PixelOS/LineageOS static overlays). -->

    <!-- ★ Device owner's decision, settled: no user switcher on the lock screen.
         Stock ships true (product/overlay/LgsiFrameworksOverlay.apk) and an
         earlier round matched stock on the reasoning that multi-user is a
         headline tablet feature; the owner does not use multi-user and prefers
         the cleaner lock screen. AOSP's own default is false, so this is also
         the upstream value. Consumer is SystemUI
         KeyguardStatusBarRepository.kt:71. Do not flip it back. -->
    <bool name="config_keyguardUserSwitcher">false</bool>

    <!-- Stock: true, from product/overlay/FrameworksResCommon_Sys.apk.
         AudioManager.java:7054 turns this into
         PROPERTY_SUPPORT_AUDIO_SOURCE_UNPROCESSED. The QTI HAL does support the
         unprocessed source, so reporting the AOSP default of false tells
         recording apps a capability the hardware has is unavailable. -->
    <bool name="config_supportAudioSourceUnprocessed">true</bool>

    <!-- Stock: 2500 / 4628 / 3420 (LgsiFrameworksOverlay). AOSP defaults are
         2596 / 4082 / 2850. These are Night Light's colour-temperature range and
         default; the stock triple is calibrated for this panel. Night Light is
         genuinely reachable here — config_setColorTransformAccelerated is
         already true via vendor/lineage/overlay/common/frameworks/base/core/res/
         res/values/config.xml:154 — so these are live, not dead keys. -->
    <integer name="config_nightDisplayColorTemperatureMin">2500</integer>
    <integer name="config_nightDisplayColorTemperatureMax">4628</integer>
    <integer name="config_nightDisplayColorTemperatureDefault">3420</integer>

    <!-- Miracast / Wi-Fi Display. AOSP default is false
         (core/res/res/values/config.xml:3424) and
         DisplayManagerService.java:2397-2405 only builds a WifiDisplayAdapter
         when it is true, so without this the whole vendor stack this tree
         already ships is unreachable: wfdservice64, WfdService.apk and
         libwfdnative.so are extracted, device.mk installs libinput_shim
         specifically so libwfdnative resolves MotionEvent::initialize on
         Android 16, and libwfdaac_vendor is in PRODUCT_PACKAGES. Stock turns it
         on with persist.debug.wfd.enable=1 in system/build.prop:142 — the
         partition PixelOS replaces, which is how the switch got lost. The
         matching vendor-side properties are in properties/system.prop.

         The QTI integration point exists in this tree: WifiDisplayController
         holds mExtRemoteDisplay and dispatches through
         ExtendedRemoteDisplayHelper (:767,:775), which is what WfdService.apk
         registers with; AOSP's own RemoteDisplay path is the fallback and is
         also still present (frameworks/av/media/libstagefright/wifi-display).

         ⚠️ Not yet exercised against a real sink. If casting turns out not to
         work, set this back to false and drop the five blobs rather than
         leaving a Settings entry that fails — an option that is guaranteed to
         fail is worse than an absent one. -->
    <bool name="config_enableWifiDisplay">true</bool>

</resources>
