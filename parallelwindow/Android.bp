// Rule corpus for the system-imposed parallel window.
//
// The engine lives in frameworks/base and is device-agnostic; this is the part that is not.
// It goes on /system_ext rather than /product because that is where the WindowManager Extensions
// jar it feeds already lives, and because /product on this device is reserved sideload headroom
// (HANDOFF.md, the GApps decision).
//
// ⚠️ ParallelWindowService reads /data/system/parallel_window/embedding_config.json first and lets
// a bounded, structurally valid candidate replace this file wholesale. That is the tuning loop:
// push a candidate rule set, run `wm parallel-window reload`, and watch. An invalid candidate
// falls back here; `wm parallel-window status` prints which source is live.
prebuilt_etc {
    name: "malbec_parallel_window_rules",
    src: "embedding_config.json",
    filename: "embedding_config.json",
    sub_dir: "parallel_window",
    system_ext_specific: true,
}
