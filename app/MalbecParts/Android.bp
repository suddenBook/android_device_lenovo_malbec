// SPDX-License-Identifier: Apache-2.0
//
// MalbecParts — the device-specific settings surface for the Lenovo TB390FU.
//
// Everything this app does is either (a) a call into an AOSP API that already
// exists but has no UI on a tablet, (b) a device preference that Settings has
// no place for, or (c) a projection of this ROM's permission-gated
// parallel-window control API. It contains NO ported Lenovo code. See README.md
// next to this file.
//
// Modelled on packages/apps/DolbyAtmos, which is the precedent this project
// already accepted for "device feature that needs a Settings page":
// same certificate, same system_ext_specific, same theme, same injection
// mechanism (com.android.settings.action.IA_SETTINGS + a category meta-data),
// so it lands inside Settings rather than beside it.

// The allowlist is a separate module rather than a PRODUCT_COPY_FILES line so
// that it travels with the app: same directory, same partition flag, and it
// cannot be left behind if the app ever moves.
prebuilt_etc {
    name: "privapp-permissions-org.lineageos.malbec.parts.xml",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "privapp-permissions-org.lineageos.malbec.parts.xml",
    filename_from_src: true,
}

android_app {
    name: "MalbecParts",

    // Pulls the allowlist in automatically, so no PRODUCT_PACKAGES line can
    // ship the app without it. This is the whole reason the boot loop of
    // session 16 cannot come back: forgetting the XML is no longer possible
    // without also removing the app.
    required: ["privapp-permissions-org.lineageos.malbec.parts.xml"],

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],

    // platform_apis rather than an SDK level: every interesting call here is
    // @hide — InputManager#addCustomInputGesture, InputGestureData,
    // KeyGestureEvent, BluetoothDevice#setMetadata, and the parallel-window
    // IActivityTaskManager control methods.
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,

    // ★ This is how `Updater` is kept off the device, and it needs the
    // explanation because the connection is not obvious.
    //
    // The owner has decided this port does no OTA. LineageOS adds `Updater`
    // unconditionally — vendor/lineage/config/common.mk:160-162, no switch, no
    // ifeq — so it shipped and could never find an update: 5.9 MB of app that
    // exists to fail. An app whose only behaviour is a permanent error is a bug
    // report waiting to be filed against this port.
    //
    // ⚠️ There is no way to un-add a package from an inherited product config.
    // `PRODUCT_PACKAGES := $(filter-out Updater,$(PRODUCT_PACKAGES))` after the
    // inherit LOOKS right and does nothing — measured with
    // `soong_ui --dumpvar-mode PRODUCT_PACKAGES`, Updater is still there,
    // because inherit-product defers the merge and the assignment only sees
    // this node's own value. Soong's `overrides:` is the mechanism AOSP
    // actually provides for "install this instead of that" (the quickstep
    // Launcher3 variant does exactly this), and both modules land in
    // system_ext/priv-app, so the override applies.
    //
    // Nothing of Updater's function is replaced — that is the point. If OTA is
    // ever revisited, deleting this one line brings it back.
    overrides: ["Updater"],

    static_libs: [
        "SettingsLib",
        // NOT part of the "SettingsLib" aggregate (its Android.bp lists 40
        // SettingsLib* modules and this is not one of them), so it has to be
        // named separately. It is what tells this activity whether Settings has
        // put it in the two-pane split — see
        // StylusSettingsActivity.hideNavigateUpWhenEmbedded. Settings,
        // SettingsIntelligence, WallpaperPicker2, PermissionController and
        // HealthFitness all depend on it the same way.
        "SettingsLibActivityEmbedding",
        "androidx.preference_preference",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}

// Host-side tests for the Android-free models used by the parallel-window page:
// only installed supported packages acquire rows, source-default-off packages
// remain visible, and a write is successful only when its reread matches.
java_test_host {
    name: "MalbecPartsParallelWindowModelTests",
    srcs: [
        "src/org/lineageos/malbec/parts/parallelwindow/ParallelWindowAppListModel.kt",
        "src/org/lineageos/malbec/parts/parallelwindow/ParallelWindowMutationConfirmation.kt",
        "tests/src/**/*.kt",
    ],
    static_libs: ["junit"],
    test_suites: ["general-tests"],
}
