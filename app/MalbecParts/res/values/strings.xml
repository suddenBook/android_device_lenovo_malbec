<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="app_name">Device settings</string>

    <!-- Settings top-level entry. Everything this tablet has that a Pixel does
         not: the pen, the folio keyboard, and the screen/touch pairing. -->
    <string name="device_settings_title">Device settings</string>
    <string name="device_settings_summary">Stylus, folio keyboard, refresh rate and touch mode</string>

    <!-- The same page, reached from Connected devices, where someone looking for
         the pen or the keyboard would look first. -->
    <string name="stylus_title">Stylus and keyboard</string>
    <string name="stylus_summary">Pen buttons, out-of-range alert, touch mode</string>
    <string name="stylus_default_name">Stylus</string>

    <!-- Pen buttons. Names follow the stock labels for the same HID usages, so
         a report of "the double click does the wrong thing" maps to one line in
         the keylayout. -->
    <string name="pen_buttons_category">Pen button</string>
    <string name="pen_buttons_footer">The button on the side of the pen. Each gesture can do something different. Holding the button and tapping the screen is a separate signal the pen sends for note-taking; it is not offered here because it fires while the button is held and would collide with Press and hold. The barrel buttons for erasing and right-click are handled by the screen itself.</string>
    <string name="pen_one_click">Single click</string>
    <string name="pen_two_click">Double click</string>
    <string name="pen_three_click">Triple click</string>
    <string name="pen_long_click">Press and hold</string>

    <!-- Out-of-range alert -->
    <string name="pen_alert_category">If you leave the pen behind</string>
    <string name="pen_lost_alert_title">Alert me</string>
    <string name="pen_lost_alert_summary">Notify me if the pen stays out of range</string>
    <string name="pen_lost_alert_summary_last_seen">Last connected <xliff:g id="when" example="5 minutes ago">%1$s</xliff:g></string>
    <string name="pen_lost_wake_title">Turn on the screen</string>
    <string name="pen_lost_wake_summary">Also turn the screen on, so the alert is visible without picking the tablet up. Off by default, so an alert in your bag does not drain the battery.</string>
    <string name="pen_lost_channel">Stylus left behind</string>
    <string name="pen_lost_notification_title"><xliff:g id="name" example="Lenovo Tab Pen Plus">%1$s</xliff:g> is out of range</string>
    <string name="pen_lost_notification_text">It has not reconnected. Tap to open Bluetooth settings.</string>

    <!-- Device mode -->
    <string name="touch_mode_category">Screen and touch</string>
    <string name="touch_mode_title">Device mode</string>
    <string name="touch_mode_daily">Daily — stylus works</string>
    <string name="touch_mode_game">Game — fastest touch, no stylus</string>
    <string name="touch_mode_daily_short">Daily</string>
    <string name="touch_mode_game_short">Game</string>
    <string name="touch_mode_daily_detail">120Hz Touch · Stylus On</string>
    <string name="touch_mode_game_detail">360Hz Touch · Stylus Off</string>
    <!-- Toasts. Shown on every switch, whichever surface caused it. -->
    <string name="touch_mode_daily_toast">Daily mode: the stylus works, and the screen reads finger touches 120 times a second</string>
    <string name="touch_mode_game_toast">Game mode: 360 touch readings a second and full processor clocks for longer. The stylus does not work in this mode.</string>
    <string name="touch_mode_rate_restored_toast">Above 120 Hz the stylus stops working and touch readings drop to 185 a second, so the refresh rate has been set back to 120 Hz</string>
    <string name="touch_mode_footer">The screen, the touch controller and the thermal policy move together, because the hardware cannot do all of it at once. Game mode reads finger touches 360 times a second instead of 120, and lets the processor hold its full clock until the tablet reaches 60°C rather than stepping down from 42°C — but the touch controller stops scanning for the stylus entirely. Daily is the default and the only mode the stylus works in.</string>

    <!-- Double-tap to wake. The summary says what it costs, because this is the
         one row on the page whose cost is not obvious: the touch controller keeps
         a low-power scan running while the screen is off. -->
    <string name="gesture_wake_title">Double-tap to wake</string>
    <string name="gesture_wake_summary">Tap the screen twice to wake the tablet. The touch controller keeps scanning at low power while the screen is off.</string>

    <!-- The refresh-rate ceiling. It is a row inside "Screen and touch", not a
         section of its own: on this panel the refresh rate and the touch/stylus
         mode are one hardware setting, so "Refresh rate" reads correctly under
         that heading and "Screen refresh rate" would repeat the word the
         heading already carries. -->
    <string name="refresh_rate_title">Refresh rate</string>
    <string name="refresh_rate_60" translatable="false">60 Hz</string>
    <string name="refresh_rate_90" translatable="false">90 Hz</string>
    <string name="refresh_rate_120" translatable="false">120 Hz</string>
    <string name="refresh_rate_footer">The screen holds this rate rather than dropping when the picture is still, because on this panel the lower rates flicker visibly. Battery saver caps it at 60 Hz on top of your choice. A lower limit saves power on a screen this size. \n\nThe panel can also do 144 Hz and this tablet deliberately does not offer it: above 120 Hz the touch controller cannot detect the stylus at all, and finger readings drop from 360 to 185 times a second. 144 Hz costs the stylus and half the touch sampling to buy 24 frames, so there is no setting here in which it would be the better choice.</string>

    <string name="pen_mode_tile_label">Device mode</string>
    <string name="pen_mode_widget_label">Device mode</string>
    <string name="pen_mode_widget_description">Switch between Daily and Game mode from the home screen.</string>
    <string name="pen_mode_widget_action">Tap to switch</string>

    <!-- Keyboard -->
    <string name="keyboard_keys_category">Folio keyboard keys</string>
    <string name="keyboard_touchpad">Touchpad key (F7)</string>
    <string name="keyboard_split">Split-screen key (F10)</string>
    <string name="keyboard_pc_link">PC link key (F11)</string>
    <string name="keyboard_app1">Assistant key (right of F12)</string>
    <string name="keyboard_app2">Apps key (far right)</string>
    <string name="keyboard_search">Fn + Assistant key</string>
    <string name="keyboard_fullscreen">Full screen key (F9)</string>
    <string name="keyboard_footer">Seven keys whose printed function either has no Android equivalent or is meant to be chosen by you. Everything else in the function row — mute, volume, microphone, brightness, screenshot and lock — is already handled by Android and by the keyboard\'s own firmware. Hold Fn to get plain F1–F12.</string>

