    <string name="action_remote_primary">Remote: play or pause</string>
    <string name="action_remote_next">Remote: next</string>
    <string name="action_remote_previous">Remote: previous</string>
    <string name="action_camera_shutter">Camera shutter</string>
    <string name="action_screenshot">Take a screenshot</string>
    <string name="action_notes">Open notes</string>
    <string name="action_assistant">Assistant</string>
    <string name="action_search">Search</string>
    <string name="action_recents">Recent apps</string>
    <string name="action_all_apps">All apps</string>
    <string name="action_home">Home</string>
    <string name="action_back">Back</string>
    <string name="action_notification_panel">Notification shade</string>
    <string name="action_lock_screen">Lock the screen</string>
    <string name="action_split_left">Split screen, left</string>
    <string name="action_split_right">Split screen, right</string>
    <string name="action_dnd">Do Not Disturb</string>
