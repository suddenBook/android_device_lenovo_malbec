<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="app_name">Stylus and keyboard</string>

    <!-- Settings > Connected devices tile -->
    <string name="stylus_title">Stylus and keyboard</string>
    <string name="stylus_summary">Pen buttons, out-of-range alert, touch mode</string>
    <string name="stylus_default_name">Stylus</string>

    <!-- Pen buttons. Names follow the stock labels for the same HID usages, so
         a report of "the double click does the wrong thing" maps to one line in
         the keylayout. -->
    <string name="pen_buttons_category">Pen button</string>
    <string name="pen_buttons_footer">The button on the side of the pen. Each gesture can do something different. The pen\'s barrel buttons for erasing and right-click are handled by the screen itself and are not set here.</string>
    <string name="pen_one_click">Single click</string>
    <string name="pen_two_click">Double click</string>
    <string name="pen_three_click">Triple click</string>
    <string name="pen_long_click">Press and hold</string>
    <string name="pen_press_click">Press</string>

    <!-- Out-of-range alert -->
    <string name="pen_alert_category">If you leave the pen behind</string>
    <string name="pen_lost_alert_title">Alert me</string>
    <string name="pen_lost_alert_summary">Vibrate and notify if the pen stays out of range</string>
    <string name="pen_lost_alert_summary_last_seen">Last connected <xliff:g id="when" example="5 minutes ago">%1$s</xliff:g></string>
    <string name="pen_lost_wake_title">Turn on the screen</string>
    <string name="pen_lost_wake_summary">Wake the tablet as well as vibrating. Off by default, so an alert in your bag does not drain the battery.</string>
    <string name="pen_lost_channel">Stylus left behind</string>
    <string name="pen_lost_notification_title"><xliff:g id="name" example="Lenovo Tab Pen Plus">%1$s</xliff:g> is out of range</string>
    <string name="pen_lost_notification_text">It has not reconnected. Tap to open Bluetooth settings.</string>

    <!-- Touch and refresh mode -->
    <string name="touch_mode_category">Screen and touch</string>
    <string name="touch_mode_title">Touch mode</string>
    <string name="touch_mode_stylus">Stylus mode: 120 Hz, pen enabled</string>
    <string name="touch_mode_game">Game mode: 144 Hz, faster touch, pen disabled</string>
    <string name="touch_mode_stylus_short">Stylus</string>
    <string name="touch_mode_game_short">Game</string>
    <string name="touch_mode_stylus_detail">120 Hz · pen on</string>
    <string name="touch_mode_game_detail">144 Hz · pen off</string>
    <string name="touch_mode_footer">The screen and the touch controller share one setting because the hardware cannot do both at once. At 144 Hz the controller stops scanning for the pen entirely, and finger touches are read three times as often. Stylus mode is the default.</string>

    <string name="pen_mode_tile_label">Touch mode</string>
    <string name="pen_mode_widget_label">Touch mode</string>

    <!-- Keyboard -->
    <string name="keyboard_title">Advanced keyboard settings</string>
    <string name="keyboard_keys_category">Customisable keys</string>
    <string name="keyboard_app1">App key 1</string>
    <string name="keyboard_app2">App key 2</string>
    <string name="keyboard_footer">These are the only two keys on this keyboard that can be reassigned. The rest of the function row is fixed in the keyboard\'s own firmware.</string>

