<resources>
    <string-array name="touch_mode_entries" translatable="false">
        <item>@string/touch_mode_daily</item>
        <item>@string/touch_mode_game</item>
    </string-array>

    <!-- Must match Constants.TOUCH_MODE_*. ⚠️ "stylus" is the wire value for
         Daily mode and is deliberately unchanged by the rename — see the comment
         on Constants.TOUCH_MODE_DAILY. Changing it here breaks init.malbec.rc. -->
    <string-array name="touch_mode_values" translatable="false">
        <item>stylus</item>
        <item>game</item>
    </string-array>

    <!-- Screen refresh rate. 144 is deliberately absent — above 120 the digitizer
         cannot see the pen at all and the finger report rate falls from 360 to
         185 Hz, so there is no configuration above 120 in which a user of this
         tablet is better off. See Constants.REFRESH_RATE_CHOICES for the measured
         table and for why this list exists at all rather than AOSP's own picker.

         ⚠️ Must stay in step with Constants.REFRESH_RATE_CHOICES; a value not in
         that list is rejected by PenModeController.currentRefreshRate() and the
         row would silently fall back to 120. -->
    <string-array name="refresh_rate_entries" translatable="false">
        <item>@string/refresh_rate_60</item>
        <item>@string/refresh_rate_90</item>
        <item>@string/refresh_rate_120</item>
    </string-array>

    <string-array name="refresh_rate_values" translatable="false">
        <item>60.0</item>
        <item>90.0</item>
        <item>120.0</item>
    </string-array>
</resources>
