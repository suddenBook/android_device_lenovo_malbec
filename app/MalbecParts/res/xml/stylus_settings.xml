<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/device_settings_title">

    <!-- Parallel windows, as a row rather than a Settings tile.

         It sits OUTSIDE the four categories, and above them, on purpose: this is
         a door to another page, not a setting on this one, and it belongs to
         none of "Pen button" / "Folio keyboard keys" / "If you leave the pen
         behind" / "Screen and touch". Inventing a one-row category to hold it
         would add a heading with nothing to say.

         ⚠️ No android:icon. That is the request, and it is also what every other
         row on this page does — icons live on the Settings homepage, not inside
         a page. See the AndroidManifest comment above the activity for why the
         "no icon" half of the request is what settles it as a row rather than a
         second homepage tile.

         The <intent> child is androidx's own mechanism (PreferenceInflater parses
         it and calls Preference.setIntent), so this needs no code in
         StylusSettingsFragment. Explicit component, in-process, which is why the
         activity can be exported="false".

         android:persistent="false" because this row has no value — without it a
         key in a PreferenceScreen invites the next reader to look for one. -->
    <Preference
        android:key="parallel_window"
        android:title="@string/parallel_window_title"
        android:summary="@string/parallel_window_tile_summary"
        android:persistent="false">
        <intent
            android:targetPackage="org.lineageos.malbec.parts"
            android:targetClass="org.lineageos.malbec.parts.parallelwindow.ParallelWindowSettingsActivity" />
    </Preference>

    <PreferenceCategory
        android:key="cat_pen_buttons"
        android:title="@string/pen_buttons_category">

        <Preference
            android:key="pen_one_click"
            android:title="@string/pen_one_click"
            android:persistent="false" />

        <Preference
            android:key="pen_two_click"
            android:title="@string/pen_two_click"
            android:persistent="false" />

        <Preference
            android:key="pen_three_click"
            android:title="@string/pen_three_click"
            android:persistent="false" />

        <Preference
            android:key="pen_long_click"
            android:title="@string/pen_long_click"
            android:persistent="false" />

        <com.android.settingslib.widget.FooterPreference
            android:key="pen_buttons_footer"
            android:title="@string/pen_buttons_footer"
            android:selectable="false" />

    </PreferenceCategory>

    <!-- The folio keyboard's reassignable keys. Merged into this page rather
         than living behind Settings > System > Keyboard > Physical keyboard >
         Advanced keyboard settings: this page is already called "Stylus and
         keyboard", and the owner reported the keyboard half was effectively
         undiscoverable four levels down. Both entry points now land here. -->
    <PreferenceCategory
        android:key="cat_keyboard_keys"
        android:title="@string/keyboard_keys_category">

        <Preference
            android:key="keyboard_touchpad"
            android:title="@string/keyboard_touchpad"
            android:persistent="false" />

        <Preference
            android:key="keyboard_split"
            android:title="@string/keyboard_split"
            android:persistent="false" />

        <Preference
            android:key="keyboard_pc_link"
            android:title="@string/keyboard_pc_link"
            android:persistent="false" />

        <Preference
            android:key="keyboard_app1"
            android:title="@string/keyboard_app1"
            android:persistent="false" />

        <Preference
            android:key="keyboard_app2"
            android:title="@string/keyboard_app2"
            android:persistent="false" />

        <Preference
            android:key="keyboard_search"
            android:title="@string/keyboard_search"
            android:persistent="false" />

        <Preference
            android:key="keyboard_fullscreen"
            android:title="@string/keyboard_fullscreen"
            android:persistent="false" />

        <com.android.settingslib.widget.FooterPreference
            android:key="keyboard_footer"
            android:title="@string/keyboard_footer"
            android:selectable="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="cat_pen_alert"
        android:title="@string/pen_alert_category">

        <SwitchPreferenceCompat
            android:key="pen_lost_alert"
            android:title="@string/pen_lost_alert_title"
            android:summary="@string/pen_lost_alert_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="pen_lost_wake"
            android:title="@string/pen_lost_wake_title"
            android:summary="@string/pen_lost_wake_summary"
            android:dependency="pen_lost_alert"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- ★ One category, not two. The refresh-rate ceiling used to have a section
         of its own titled "Screen refresh rate", holding exactly one row — and
         the owner's objection to that is also the technical argument for the
         merge: on this panel the refresh rate is not an independent knob. It is
         the same hardware setting as Device mode (above 120 Hz the digitizer
         stops seeing the pen and the finger report rate halves, 360 -> 185), so
         a reader who finds one and not the other has been told half the story.
         See Constants.REFRESH_RATE_MAX and OPEN-ISSUES.md #13. -->
    <PreferenceCategory
        android:key="cat_touch_mode"
        android:title="@string/touch_mode_category">

        <ListPreference
            android:key="touch_mode"
            android:title="@string/touch_mode_title"
            android:entries="@array/touch_mode_entries"
            android:entryValues="@array/touch_mode_values"
            android:defaultValue="stylus"
            android:summary="%s"
            android:persistent="false" />

        <!-- ★ persistent="true", unlike every other row on this page.
             PenModeController.currentRefreshRate() reads this preference and
             treats it as the source of truth, so androidx storing it here is the
             mechanism, not an accident: peak_refresh_rate is the thing being
             driven, and a backup restore or a stray `settings put` must not be
             able to erase the choice by overwriting it. See the KDoc on
             currentRefreshRate.

             No defaultValue. An absent preference means "120" via
             REFRESH_RATE_MAX; declaring "120.0" here as well would put the same
             constant in two places that must agree. -->
        <ListPreference
            android:key="refresh_rate"
            android:title="@string/refresh_rate_title"
            android:entries="@array/refresh_rate_entries"
            android:entryValues="@array/refresh_rate_values"
            android:summary="%s" />

        <!-- ★ Double-tap to wake. persistent="false" for the same reason as the
             Device mode row: persist.sys.malbec.gesture_wake is the source of
             truth, because init.malbec.rc is what writes /proc/gesture_mode and
             init cannot read a SharedPreference.

             No defaultValue, deliberately. "Absent means on" is expressed once,
             in init.malbec.rc's unconditional write at boot_completed; declaring
             `true` here as well would put the default in two places that have to
             agree, which is the mistake the refresh-rate comment above calls out. -->
        <SwitchPreferenceCompat
            android:key="gesture_wake"
            android:title="@string/gesture_wake_title"
            android:summary="@string/gesture_wake_summary"
            android:persistent="false" />

        <!-- ⚠️ Two footers in one category, and their order is NOT this
             declaration order. FooterPreference's constructor calls
             init() -> setOrder(ORDER_FOOTER) AFTER super() has parsed the
             attributes (FooterPreference.java:222), so android:order is
             overwritten, both tie at Integer.MAX_VALUE - 1, and
             Preference.compareTo falls through to comparing their TEXT
             case-insensitively. StylusSettingsFragment pins the order in code
             instead; without that pin, editing the first word of either string
             would silently reorder the page. -->
        <com.android.settingslib.widget.FooterPreference
            android:key="touch_mode_footer"
            android:title="@string/touch_mode_footer"
            android:selectable="false" />

        <com.android.settingslib.widget.FooterPreference
            android:key="refresh_rate_footer"
            android:title="@string/refresh_rate_footer"
            android:selectable="false" />

    </PreferenceCategory>

</PreferenceScreen>
