<?xml version="1.0" encoding="utf-8"?>
<!--
     SPDX-FileCopyrightText: The LineageOS Project
     SPDX-License-Identifier: Apache-2.0

     ⚠️ This drawable exists because the previous version set
     android:background="?android:attr/colorBackgroundFloating" plus
     android:clipToOutline="true" and got SQUARE CORNERS. clipToOutline clips to
     the BACKGROUND DRAWABLE's outline, and a resolved colour is a ColorDrawable
     whose outline is a plain rectangle — so the attribute was a no-op and the
     widget was the only hard-edged rectangle on a Material You home screen.

     @android:dimen/system_app_widget_background_radius is the platform's own
     answer (core/res/res/values/dimens.xml:1242-1243, public at
     public-final.xml:3160). It is 28dp, or 24dp when
     android.appwidget.flags.use_smaller_app_widget_system_radius is on — which
     it IS on this build (measured: `adb shell aflags list` reports it enabled),
     so this matches every stock widget beside it without hardcoding either
     number.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
    <solid android:color="@color/widget_bg" />
</shape>
