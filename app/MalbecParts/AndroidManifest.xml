<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.malbec.parts"
    android:sharedUserId="android.uid.system">

    <!-- MANAGE_KEY_GESTURES is signature (core/res/AndroidManifest.xml:8945).
         It gates addCustomInputGesture / registerKeyGestureEventHandler,
         enforced in InputManagerService.java:3180-3229. -->
    <uses-permission android:name="android.permission.MANAGE_KEY_GESTURES" />
    <!-- Injecting the concrete keycode in "Smart remote". Signature. -->
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    <!-- Reading the foreground package to pick the remote-control profile.
         signature|privileged, so it is also listed in
         privapp-permissions-org.lineageos.malbec.parts.xml. -->
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <!-- Pen link state, and setMetadata(DEVICE_TYPE_STYLUS) on the bonded pen.
         BLUETOOTH_PRIVILEGED is signature|privileged; likewise allowlisted. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    <!-- peak_refresh_rate / min_refresh_rate live in Settings.System. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- The anti-loss alert: optionally wake the panel, then notify.
         PowerManager#wakeUp enforces DEVICE_POWER (signature|role) — not
         TURN_SCREEN_ON, which gates Activity#setTurnScreenOn and which this app
         never calls.
         No VIBRATE: this device has no vibrator (dumpsys vibrator_manager
         reports vibratorIds = [] and there is no android.hardware.vibrator
         feature), so asking for it would advertise a capability that cannot
         exist here. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.DEVICE_POWER" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The action picker lists every launchable app. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubSettingsBase.Expressive">

        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- An OTA that replaces this APK kills the process, and with it
                     the five private KeyGestureEvent handler registrations
                     (KeyGestureController.binderDied -> onKeyGestureHandlerRemoved,
                     :1611-1615). The bindings survive in input_gestures.xml, so
                     `dumpsys input` still shows them while nothing dispatches
                     them. This re-registers without waiting for a reboot. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The long-lived half: the key-gesture handler for Smart remote, the
             pen-link watcher for the out-of-range alert, and the observer that
             keeps the touch report rate paired with the refresh rate.
             Started from BootCompletedReceiver and from each settings screen.

             Deliberately NOT android:persistent — DolbyAtmos is persistent and
             that is a reasonable choice for an audio effect that must survive
             every process death, but pinning a process into memory forever for
             three callbacks is exactly what makes a port feel heavier than
             stock. START_STICKY plus the boot receiver covers it. -->
        <service
            android:name=".MalbecPartsService"
            android:exported="false" />

        <!-- ★ Settings top level, "Device settings".
             Owner's call: this page collects everything the tablet has that a
             Pixel does not — the pen, the folio keys, the screen/touch pairing
             and the refresh-rate ceiling — and burying that under Connected
             devices made half of it undiscoverable. It is the same complaint
             that moved the keyboard half here in the first place.

             CategoryKey.CATEGORY_HOMEPAGE
             (SettingsLib/Tile/.../CategoryKey.java:24) is what
             DashboardFragmentRegistry:77 maps TopLevelSettings to, so declaring
             it is the whole mechanism — no Settings source change.

             ⚠️ group_key is not optional here. DashboardFragment:608-616 puts a
             tile inside a PreferenceCategory only when the tile names one and
             that name resolves to a PreferenceCategory; otherwise it falls
             through to screen.addPreference() and lands OUTSIDE every card, at
             the bottom of an Expressive homepage built entirely out of them.
             top_level_system_info_category is res/xml/top_level_settings.xml:127
             — Storage, Battery, System, About device.

             order -15 puts it between System (-20) and About device (-10).
             META_DATA_KEY_ORDER is TileUtils.java:129; it is an int, so
             android:value is correct here and android:resource is not. -->
        <activity
            android:name=".stylus.StylusSettingsActivity"
            android:label="@string/device_settings_title"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="top_level_system_info_category" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-15" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_stylus" />
            <!-- ⚠️ android:resource, NOT android:value. With android:value a
                 @string/ reference is coerced to a literal String at PARSE time
                 (ParsingPackageUtils.java:3272-3281 peeks android:resource first
                 and stores an int; otherwise it coerceToString()s the value), and
                 Tile.java:243-255 only calls res.getString() on the Integer
                 branch. So android:value froze this summary in the build
                 language forever. The icon two lines up was already correct
                 because Tile.java:303 requires an int there; the summary was not.
                 TileUtils.java:178-179 says the same for the sibling title key. -->
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/device_settings_summary" />
        </activity>

        <!-- The same page, second door: Settings > Connected devices >
             "Stylus and keyboard". The pen and the folio ARE connected devices
             and that is where someone goes looking for them, so promoting the
             page to the top level is a reason to add an entry point, not to
             remove one.

             An alias rather than a second activity because TileUtils keys its
             cache on (packageName, componentInfo.name) — TileUtils.java:400-402 —
             and for an alias that name is the ALIAS, so the two produce two
             distinct tiles from one implementation. queryIntentActivitiesAsUser
             resolves aliases and carries their own meta-data, and resolved.system
             (:338) holds because this is a system_ext priv-app.

             Settings > System > Keyboard > Physical keyboard > "Advanced keyboard
             settings" lands here too. That hook is already in AOSP:
             packages/apps/Settings/res/xml/physical_keyboard_settings.xml:83-89
             declares a RemotePreference with
             settings:requiresAction="org.lineageos.settings.device.ADVANCED_KEYBOARD_SETTINGS"
             and hides itself when nothing answers. It is on the alias rather than
             on the top-level activity because it is a keyboard-shaped door. -->
        <activity-alias
            android:name=".stylus.StylusSettingsConnectedDevicesAlias"
            android:targetActivity=".stylus.StylusSettingsActivity"
            android:label="@string/stylus_title"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.lineageos.settings.device.ADVANCED_KEYBOARD_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.connect" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_stylus" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/stylus_summary" />
        </activity-alias>

        <!-- ★ Marker that makes this package the launcher's layout customisation
             provider, so res/xml/default_layout_6x5_h6.xml becomes the default
             home screen and the Device mode widget is already on it after a
             flash. Nothing is ever broadcast to this receiver; see
             LauncherLayoutMarker for the mechanism and why exported="false" is
             still discoverable.

             ⚠️ Verified free before claiming it:
                 cmd package query-receivers -a \
                     android.autoinstalls.config.action.PLAY_AUTO_INSTALL
             returned "No receivers found" on this build. The sibling marker
             action, com.android.launcher3.action.PARTNER_CUSTOMIZATION, is
             already held by com.google.android.apps.wallpaper.pixel — that is why
             this is the action to use and not that one. -->
        <receiver
            android:name=".launcher.LauncherLayoutMarker"
            android:exported="false">
            <intent-filter>
                <action android:name="android.autoinstalls.config.action.PLAY_AUTO_INSTALL" />
            </intent-filter>
        </receiver>

        <!-- Shared "what should this key do?" picker, used by both screens. -->
        <activity
            android:name=".gesture.ActionPickerActivity"
            android:label="@string/action_picker_title"
            android:exported="false" />

        <!-- Quick Settings tile for the stylus/game mode switch. Reachable from
             inside a full-screen game, which a home-screen widget is not. -->
        <service
            android:name=".display.PenModeTileService"
            android:icon="@drawable/ic_stylus"
            android:label="@string/pen_mode_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Home-screen widget for the same switch, because the owner asked for
             one-tap-from-the-desktop specifically. -->
        <!-- ⚠️ exported="false". It was true, which let any uid flip the panel
             mode and rewrite /proc with
                 am broadcast -a org.lineageos.malbec.parts.TOGGLE_PEN_MODE \
                     -n org.lineageos.malbec.parts/.display.PenModeWidgetProvider
             because TOGGLE_PEN_MODE is not a protected broadcast. Neither
             legitimate sender needs it: APPWIDGET_UPDATE comes from system_server
             and the click arrives via a PendingIntent, both uid 1000, and
             ActivityManager.canAccessUnexportedComponents (:5405-5423) grants
             ROOT_UID/SYSTEM_UID access to unexported components. -->
        <receiver
            android:name=".display.PenModeWidgetProvider"
            android:label="@string/pen_mode_widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pen_mode_widget_info" />
        </receiver>

    </application>
</manifest>
