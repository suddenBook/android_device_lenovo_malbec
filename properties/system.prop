# SurfaceFlinger
# Carried over from the stock ZUI 18 build. set_idle_timer_ms and
# set_touch_timer_ms drive the variable refresh rate behaviour.
#
# ⚠️ set_launcher_timer_ms / set_pen_timer_ms / set_refresh_timer_ms were here
# too, with a comment claiming set_pen_timer_ms "matters for latency when
# drawing". Removed in session 12: Android 16 reads none of the three. They are
# absent from frameworks/native/services/surfaceflinger/sysprop/
# SurfaceFlingerProperties.sysprop and from all of frameworks/native and
# frameworks/base, and `grep -rlaF` over the BUILT image finds each string only
# inside build.prop itself -- never in system/bin/surfaceflinger,
# libSurfaceFlingerProp.so or any vendor library. The two that survive here do
# appear in libSurfaceFlingerProp.so, which is how the difference was measured.
debug.sf.enable_hwc_vds=0
# debug.sf.latch_unsignaled and debug.sf.auto_latch_unsignaled moved to
# vendor.prop. Stock ships latch_unsignaled twice -- system/build.prop:148 says
# 1, vendor/build.prop:284 says 0 -- and vendor is loaded last
# (property_service.cpp:1171-1188), so 0 is what the device actually runs.
# Verified with getprop on the running stock ROM. Copying the system-side 1 here
# inverted it.
ro.surface_flinger.display_update_imminent_timeout_ms=1000
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.game_default_frame_rate_override=60
ro.surface_flinger.set_idle_timer_ms=2000
ro.surface_flinger.set_touch_timer_ms=3000
ro.surface_flinger.supports_background_blur=0
ro.surface_flinger.use_content_detection_for_refresh_rate=true

# Default display orientation
#
# This is a 13" landscape tablet in a keyboard folio, but its *natural*
# orientation is portrait and has to stay that way. The panel scans out
# 3504x2190 (landscape) -- confirmed on the live device from the DRM connector
# (/sys/class/drm/card0-DSI-1/modes) and from SurfaceFlinger's HWC mode list --
# and ro.surface_flinger.primary_display_orientation=ORIENTATION_270 in
# vendor.prop rotates it so every framework client sees a 2190x3504 portrait
# display. Stock does exactly the same (dumpsys-display.txt:101,
# installOrientation=3). Do NOT "fix" that by removing the property: the touch
# digitizer, the pen digitizer and the QTI device_orientation sensor are all
# defined in the portrait frame, and while TouchInputMapper can be compensated
# with touch.orientation in an IDC (TouchInputMapper.cpp:366-380), nothing in
# the framework can rotate a *sensor* frame, so auto-rotate would break.
#
# AOSP has a first-class mechanism for exactly this shape, and its comment at
# DisplayRotation.java:316-327 describes this device almost word for word:
# "on tablets that may want to keep natural orientation portrait for
#  applications compatibility but have landscape orientation as a default
#  choice from the UX perspective."
#
# One property, two readers:
#   - BootAnimation.cpp:644-659 -- the boot animation surface and projection.
#   - DisplayRotation.readDefaultDisplayRotation() (:328-350), whose result
#     becomes the initial mRotation at :271-272 -- so Setup Wizard and the lock
#     screen come up landscape too.
# Four values are accepted: ORIENTATION_{0,90,180,270}; 0 or unset is a no-op.
#
# ORIENTATION_90, not 270: DisplayDevice.cpp:242 composes the WindowManager
# rotation with the physical orientation, so 90 + 270 = 0, i.e. identity into
# the native 3504x2190 framebuffer with no extra rotation work.
#
# ⚠️ Must live on system, not vendor. system/sepolicy/private/property_contexts
# only labels ro.bootanim.quiescent.enabled; ro.bootanim.set_orientation_* falls
# through to default_prop, which vendor_init is not allowed to set -- the same
# trap vendor.prop already documents. It is also read by the boot animation,
# which is a system component.
#
# The other half of this is def_user_rotation=1 in
# overlay/SettingsProviderOverlayMalbec: auto-rotate ships off
# (def_accelerometer_rotation is false), and the rotation-locked branch of
# DisplayRotation returns USER_ROTATION, which would otherwise put it back to 0
# as soon as the settings database is created. Neither half works alone.
ro.bootanim.set_orientation_logical_0=ORIENTATION_90

# Media
ro.media.recorder-max-base-layer-fps=60

# QTI "vendor assist" support flag, AOSP side. This is the counterpart of the
# ro.vendor.qti.va_odm.support=1 that properties/odm.prop already carries; the
# factory sets both, on system and odm respectively, and shipping only one half
# was an oversight rather than a decision.
ro.vendor.qti.va_aosp.support=1

# Miracast / Wi-Fi Display.
#
# The whole stack is already installed and was never switched on: wfdservice64,
# WfdService.apk and libwfdnative.so come across as blobs, device.mk installs
# libinput_shim specifically to give libwfdnative the pre-Android-16
# MotionEvent::initialize symbol, and libwfdaac_vendor is in PRODUCT_PACKAGES.
# What was missing is the framework side. AOSP's config_enableWifiDisplay
# defaults to false (frameworks/base/core/res/res/values/config.xml:3424) and
# DisplayManagerService.java:2397-2405 only constructs WifiDisplayAdapter when it
# is true, so none of the above could ever be reached. The bool is set in
# FrameworkOverlayMalbec; these two are the vendor-stack half of the same
# switch, and both are verbatim from the factory system/build.prop:142-144.
#
# The QTI path is real on this tree, not a hope: WifiDisplayController keeps an
# mExtRemoteDisplay and routes through ExtendedRemoteDisplayHelper
# (frameworks/base/services/core/java/com/android/server/display/, :767,:775),
# which is exactly the hook WfdService.apk plugs into. If it is ever unavailable
# the controller falls back to AOSP's own RemoteDisplay, which is also still
# present in this tree (frameworks/av/media/libstagefright/wifi-display).
#
# ⚠️ NOT verified on hardware yet -- the stack is complete and matches stock, but
# nobody has cast to a sink. If it turns out broken, the honest fix is to set
# config_enableWifiDisplay back to false and drop the five blobs, not to leave a
# menu entry that fails.
persist.debug.wfd.enable=1
persist.sys.wfd.virtual=0

# ═══════════════════════════════════════════════════════════════════════════
# Log levels
# ═══════════════════════════════════════════════════════════════════════════
#
# Measured on the running build, from work/s16/boot0/logcat-all.txt: in a
# 60-second window with the SCREEN ON, sitting idle at the launcher, the main
# buffer takes 3276 lines -- about 55 per second. That is not a diagnostic aid,
# it is a diagnostic obstacle: the one line that matters is buried, and logd's
# 64 MB buffer holds minutes instead of hours.
#
# ⚠️ Screen state matters and must be stated whenever this is re-measured. The
# same device with the screen OFF and dozing produces 135 lines per 60 s. Quote
# the wrong one and the numbers look like a tenfold improvement that nothing
# caused.
#
# ── How this works, because it is counter-intuitive ────────────────────────
#
# `log.tag.<TAG>` sets a MINIMUM PRIORITY, and it is enforced inside liblog for
# EVERY writer, including hardcoded ALOGD/ALOGV/Slog.d that no build flag can
# reach: __android_log_is_loggable_len is consulted at
# system/logging/liblog/logger_write.cpp:388 and :402, and Java's
# Log.println_native routes through the same call
# (frameworks/base/core/jni/android_util_Log.cpp:94). So this silences vendor
# blobs we do not build, which is the only lever we have over them.
#
# Values: V < D < I < W < E < F < S. `=W` keeps warnings and errors and drops
# the chatter below them. Everything here is a NON-ro property, so any of it can
# be undone live for one debugging session without a reflash:
#     adb shell setprop log.tag.WifiHAL V
#
# ── The rule used to decide ────────────────────────────────────────────────
#
# Silence only messages that carry no incremental information. A repeated
# message that indicates a real defect stays visible, even when it is the
# loudest thing in the buffer -- silencing a symptom is how a defect gets
# forgotten. Two of the biggest offenders are therefore deliberately NOT here;
# see the end of this block.

# WifiHAL — one V line per BSS per field, on every scan. 444 lines/minute at
# idle, the single largest source in the buffer. wpa_supplicant and the
# framework already log every state transition that matters.
log.tag.WifiHAL=W

# AGM — `metadata: metadata_print:` dumps every key/value of every audio graph
# metadata blob at D. 223 lines/minute.
log.tag.AGM=I

# PAL — the same subsystem one layer up: findKVs / setDeviceMediaConfig traces.
log.tag.PAL=W

# SDM — `Received Idle Timeout` and `Tear down the Concurrent Writeback
# topology` at I, twice a second whenever the panel idles. Display errors are
# at E and stay.
log.tag.SDM=W

# PERFHAL-CLIENT — 192 identical `perf_lock_acq() 170: opcode=... isMvOpcode=0`
# lines. Logged at E, but it is a call trace, not an error: it fires on every
# successful perf lock acquisition. Nothing distinguishes one line from the
# next, so E is not usable for this tag at all.
log.tag.PERFHAL-CLIENT=F

# PERFHAL-SCENARIOD-BRIDGE — 538 lines in work/s17/boot1/logcat-stream.txt, and
# `sed 's/[0-9]\+/N/g' | sort -u` on them returns exactly ONE line:
#     SubmitScenarioDRequest() N: Request not submitted as Target Init is not complete
# So the tag has no second message to lose. The window is 18:12:18 -> 18:12:24,
# six seconds: every process that starts during boot asks the perf HAL for a
# boost before the HAL has finished polling core-online state, and each refusal
# is logged at E. Requests after target init succeed and say nothing.
#
# ⚠️ The boosts in those six seconds really are dropped, so this DOES hide a
# (small) defect: early-boot perf hints do not apply. It is not fixable from the
# device tree -- targetconfig.xml already lists soc_id 694 under Target="tuna",
# byte-identical to stock (verified), so the config is not what is late. Keeping
# 538 identical lines would not fix it either; it would only make the next
# person's boot log 0.4 % noisier.
log.tag.PERFHAL-SCENARIOD-BRIDGE=F

# sec_channel — ⚠️ DELIBERATELY NOT SILENCED, and the reason is a correction.
#
# An earlier draft of this block set log.tag.sec_channel=F, on the stated
# grounds that /vendor/bin/ssgtzd "retries every 5 seconds, forever". Measured
# against the actual capture, that is wrong:
#
#   18:28:40.797  Modemcomm: Init Instance on handle:0 failed with -3
#   18:28:40.797  Modemcomm: Failed to get handle of SSGQMSCA service
#   ... every 5 s ...
#   18:31:30.989  Modemcomm: Failed to get handle of SSGSCA service as well
#                 - exiting
#
# 67 lines over 170 seconds, then it stops. Re-confirmed on the running device
# an hour later: zero sec_channel lines in a 60-second window while ssgtzd is
# still resident (pid 1520). It is a bounded boot-time burst, not a spammer, and
# 67 lines is not worth spending a suppression on.
#
# It is left visible on top of that, because the last line is informative: it is
# this device telling us that the Secure Services Group's QMI Secure Channel
# Agent, which lives on the MODEM, is unreachable -- which it must be, since
# ro.baseband=apq and there is no modem.
#
# ⚠️ Do not delete ssgtzd on the strength of that. It is the TrustZone-side
# secure channel daemon, and there is an unresolved lead: KeyMint attestation on
# this build fails with SECURE_HW_COMMUNICATION_FAILED (-49), and this is the
# other secure-channel daemon in the system. No evidence links them yet, and
# session 15 has already shown what happens when a service is removed because it
# looked idle (`qms` -> memperfd wedged forever).

# SP — Google's on-device handwriting/speech models complaining that a TFLite
# zip file ref was finalised without being closed. An app-side leak in a
# preinstalled GMS package; nothing here can fix it.
log.tag.SP=E

# AOSP-MdnsDiscoveryManag / MdnsServiceBrowser — one line per mDNS query and
# response. 156 lines/minute with a Chromecast on the network.
log.tag.AOSP-MdnsDiscoveryManag=W
log.tag.MdnsServiceBrowser=W

# The rest, same rule, smaller volume.
log.tag.cnss-daemon=W
log.tag.sensors-hal=W
log.tag.BackgroundInstallControlService=I
log.tag.DrmLibTime=W
log.tag.msm_vidc=W
log.tag.QC-time-services=W
log.tag.InetDiagMessage=W

# ── Deliberately NOT silenced ──────────────────────────────────────────────
#
# RkpdWidevine / QCOM-OEMCrypto (136 lines/minute, mostly E). These are the
# visible symptom of a real defect: OEMCrypto initialises Widevine L1
# successfully, but /data/vendor/mediadrm/IDM1013/L1/oemcert.bin does not exist
# and provisioning fails inside the TA. Until that is settled, this noise is the
# only outward sign of it, and Netflix/Prime HD depend on the answer.
#
# SettingsState ("invalid override flag name ...", ~1430 lines). Boot-only, not
# steady state, and it is GMS pushing device_config overrides for flags this
# build does not define. Loud but bounded, and it is a genuine signal about
# which Google feature flags this ROM lacks.
