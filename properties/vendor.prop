# Display
# The panel is dual sourced (BOE nt36536e / CSOT nt36536, both 144 Hz). The
# bootloader selects it on the kernel command line —
# msm_drm.dsi_display0=qcom,mdss_dsi_csot_nt36536_144hz_vid on this unit — and it
# is resolved inside the prebuilt dtbo and the vendor display HAL. Nothing here
# may be panel specific. In particular do not key anything off ro.boot.lcd_type:
# it reads "glossy" here, which is a surface finish, not a panel vendor.
#
# primary_display_orientation is ORIENTATION_270: the panel is portrait native
# and rotated to landscape. Getting this wrong gives a sideways boot animation
# and a rotated touch mapping.
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.primary_display_orientation=ORIENTATION_270
# These two go together and stock has them on adjacent lines
# (vendor/build.prop:173,174). Without the second one the first is dead code
# and the device boots sideways:
#
#   SurfaceFlinger.cpp:3538-3552 -- unless mIgnoreHwcPhysicalDisplayOrientation
#   is set, SF takes the composer's value and returns before it ever reaches the
#   primary_display_orientation branch at :3554.
#   AidlComposerHal.cpp:294-303 -- isSupported(PhysicalDisplayOrientation) is
#   unconditionally true.
#   hardware/qcom-caf/sm8750/display/hal/composer/AidlComposerClient.cpp:585-596
#   -- QTI's getDisplayPhysicalOrientation() is a stub that returns Error::None
#   *without writing the out parameter*, so SF's switch falls to
#   default: return ui::ROTATION_0.
#
# ⚠️ That last citation used to end "and this tree builds that composer from
# source, so the stub is what runs". Session 12 moved the composer to a blob, so
# the source file above is no longer what executes and that reasoning no longer
# applies. The setting is still correct, for a simpler reason: the factory ROM
# sets both of these on adjacent lines (vendor/build.prop:173,174) and runs the
# same composer binary we now ship. Keep the value, do not keep the old rationale.
debug.sf.ignore_hwc_physical_display_orientation=true

# Buffer latching. Both read off the running stock ROM rather than off
# system/build.prop, which carries a stale latch_unsignaled=1 that the vendor
# copy overrides. See the note in system.prop.
# ⚠️ debug.sf.latch_unsignaled was here and is GONE: it has zero readers in
# Android 16. SurfaceFlinger::getLatchUnsignaledConfig (SurfaceFlinger.cpp:590-596)
# reads ONLY debug.sf.auto_latch_unsignaled and otherwise returns Disabled; the
# old name survives solely in hardware/qcom-caf/*/display/config/*.mk, which are
# build-system property lists, not readers. Verified: 0 hits for the symbol
# across frameworks/native/services/surfaceflinger and frameworks/native/libs.
#
# The one below IS read, at SurfaceFlinger.cpp:591. Its value equals the AOSP
# default (true), so it is redundant -- kept because it records the intent, and
# because the paragraph it replaced in system.prop argued at length about a
# property that turned out not to exist any more.
debug.sf.auto_latch_unsignaled=1

ro.vendor.display.cabl=2
ro.vendor.display.idle_time=0
ro.vendor.display.paneltype=1
ro.vendor.display.sensortype=2
ro.vendor.display.svi=1
vendor.display.cabl.config=1
vendor.display.cabl.config_path=/vendor/etc/cablconfig.xml
vendor.display.comp_mask=0
vendor.display.disable_3d_adaptive_tm=1
vendor.display.disable_excl_rect=0
vendor.display.disable_excl_rect_partial_fb=1
vendor.display.disable_hw_recovery_dump=1
vendor.display.disable_idle_fps_switch=1
vendor.display.disable_offline_rotator=1
vendor.display.disable_scaler=0
vendor.display.disable_sdr_dimming=0
vendor.display.disable_sdr_histogram=1
vendor.display.disable_stc_dimming=1
vendor.display.enable_async_powermode=0
vendor.display.enable_async_vds_creation=1

# TODO: the remaining ~240 stock vendor properties (audio, bluetooth, camera,
# perf) are staged in work/analysis/properties-candidates/vendor.prop. They need
# to be reviewed one by one against what PixelOS already sets before being
# merged here — blindly importing them will conflict.

# ─────────────────────────────────────────────────────────────────────────────
# Everything below was derived by diffing against stock /vendor/build.prop —
# these are the entries kept out of its 285.
#
# Why do this now rather than after first boot: vendor props exist for the stock
# BLOBS this image ships, and PixelOS itself sets almost nothing in the vendor
# namespace, so the diff is computable statically and booting would add no
# information. It is the framework-side product / system_ext props that need a
# real getprop compared against PixelOS defaults.
#
# Selection rule:
#   IN  — runtime configuration for hardware this image actually ships
#         (graphics / audio / display / bluetooth / camera / codecs / perf /
#         USB / storage)
#   OUT — anything the build system generates itself (ro.vendor.build.*,
#         ro.bionic.*, ro.sf.lcd_density, ro.virtual_ab.*, ro.board.platform),
#         cellular and IMS (this device is Wi-Fi only), things only Lenovo's own
#         apps read (ro.vendor.config.lgsi.*, beluga, zui), and Lenovo telemetry
#         (diag, journey)
#
# ⚠️ Do not copy stock's two CPU-variant properties, and do not copy corrected
# versions of them either:
#
#   dalvik.vm.isa.arm64.variant=oryon
#   ro.bionic.cpu_variant=oryon
#
# The fact first: stock has these WRONG. All eight cores on this device report
# implementer 0x41 (ARM) and part 0xd82/0xd81 — Cortex-X4 plus Cortex-A720, not
# Qualcomm's own Oryon, whose implementer is 0x51. Most likely copied over from
# an SM8750 configuration.
#
# Now why not even the corrected values belong here: the build system generates
# both, and already generates them correctly.
#
#   build/make/core/sysprop_config.mk:24
#       ADDITIONAL_VENDOR_PROPERTIES += ro.bionic.cpu_variant=$(TARGET_CPU_VARIANT_RUNTIME)
#   build/make/core/sysprop_config.mk:29
#       ADDITIONAL_VENDOR_PROPERTIES += dalvik.vm.isa.$(TARGET_ARCH).variant=$(DEX2OAT_TARGET_CPU_VARIANT_RUNTIME)
#   build/make/core/config.mk:1135
#       DEX2OAT_TARGET_CPU_VARIANT_RUNTIME := first_non_empty_of_three($(TARGET_CPU_VARIANT_RUNTIME), ...)
#
# Read out of the ninja this tree generates, the actual values are
# cortex-a76 / cortex-a76 / arm64.
#
# And ADDITIONAL_VENDOR_PROPERTIES lands in the VENDOR partition — the same
# partition as this file. post_process_props.py:112-117 allows a same-partition
# duplicate only when the values agree and hard-fails otherwise. So writing them
# out here is redundant at best (and becomes a build failure the day
# TARGET_CPU_VARIANT_RUNTIME changes) and an immediate build failure at worst.
#
# The real control point is TARGET_CPU_VARIANT_RUNTIME := cortex-a76 in
# BoardConfig.mk. Change it there; do not add it here.

# Graphics driver selection — the most load-bearing section in this file.
#
# frameworks/native/opengl/libs/EGL/Loader.cpp:68-76 tries three properties in
# order to build the driver filename:
# persist.graphics.egl -> ro.hardware.egl -> ro.board.platform.
# Before this was added the tree set NONE of the three, so it fell through to
# ro.board.platform = "sun" and looked for /vendor/lib64/egl/libEGL_sun.so.
# That file does not exist — the driver is libEGL_adreno.so, extracted at
# proprietary-files.txt:1345 — so EGL never loaded a hardware driver at all.
ro.hardware.egl=adreno
ro.hardware.vulkan=adreno
ro.opengles.version=196610
# ro.hwui.use_vulkan is NOT set here. sysprop_config.mk:128-132 emits it
# unconditionally from $(TARGET_USES_VULKAN), so setting it here too is a
# duplicate assignment and post_process_props.py fails the build. The value
# now comes from TARGET_USES_VULKAN := true in BoardConfig.mk.
graphics.gpu.profiler.support=true

# SurfaceFlinger
# The phase-offset entries set the composition cadence. Stock tuned them for a
# 144 Hz panel; AOSP's defaults drop frames here.
debug.sf.use_phase_offsets_as_durations=1
debug.sf.early.app.duration=13666666
debug.sf.early.sf.duration=10500000
debug.sf.earlyGl.app.duration=13666666
debug.sf.earlyGl.sf.duration=10500000
debug.sf.late.app.duration=13666666
debug.sf.late.sf.duration=10500000
debug.sf.enable_gl_backpressure=1
# ★ 0, not stock's 1. This is one of the very few places this file deliberately
# leaves stock parity, and the reason is measurable.
#
# SurfaceFlinger.cpp:544 defaults it to 0 (cache ENABLED). With it at 1,
# Output::updateProtectedContentState / the client-composition path can never
# take the "nothing in this layer stack changed, reuse the last GPU buffer" fast
# path (Output.cpp:1428) -- every frame that needs GPU composition is fully
# re-rendered even when the screen is completely static.
#
# On this device that is not a corner case, because the rounded-corner mask
# forces CLIENT composition of the whole 3504x2190 surface
# (OutputLayer.cpp:979-982). So a motionless screen was being re-rendered at the
# full panel rate. It costs power all the time and it is the most likely single
# contributor to the flicker the owner reported in desktop mode, where several
# freeform windows are each carrying their own rounded corners.
#
# Stock ZUI sets 1 and gets away with it because ZUI has no desktop mode, so it
# never reaches the pathological case. onyx -- same SoC, official PixelOS device
# -- sets 0 (vendor.prop:93), and so does AOSP.
#
# ⚠️ Reverting this to 1 would also revert a power regression that has never
# been quantified; if you do revert it, measure first.
debug.sf.disable_client_composition_cache=0
debug.sf.predict_hwc_composition_strategy=0
debug.sf.treat_170m_as_sRGB=1
# ⚠️ debug.sf.enable_advanced_sf_phase_offset, debug.sf.hw and debug.egl.hw were
# here. Removed in session 12 -- no consumer in Android 16. Measured on the built
# image, not inferred: `strings system/bin/surfaceflinger | grep -x debug.sf.hw`
# returns 0 (it only ever matched as a prefix of debug.sf.hwc.min.duration and
# debug.sf.hwc_service_name), libEGL.so has no debug.egl.hw, and the phase-offset
# one appears nowhere outside build.prop. The neighbouring
# debug.sf.use_phase_offsets_as_durations and the early/late duration values ARE
# read by surfaceflinger and stay.
debug.graphics.game_default_frame_rate.disabled=1
ro.surface_flinger.clear_slots_with_set_layer_buffer=false
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.max_virtual_display_dimension=4096
# ⚠️ ro.surface_flinger.protected_contents and .use_color_management were here
# and are GONE: both have zero readers in Android 16. They still exist in
# frameworks/native/services/surfaceflinger/sysprop/SurfaceFlingerProperties.sysprop,
# which is why "the sysprop is defined" looks like a green light, but nothing
# calls the generated accessor -- 0 hits for either symbol across
# frameworks/native/services/surfaceflinger and frameworks/native/libs, against
# 5 for has_wide_color_display and 1 for auto_latch_unsignaled in the same scan.
# They came from stock's vendor/build.prop. The tree already deleted debug.sf.hw
# and debug.egl.hw on exactly this criterion; these two were missed.
ro.surface_flinger.wcg_composition_dataspace=143261696

# Display HAL
vendor.display.enable_cwb_cpu_boosting=1
vendor.display.enable_display_extensions=1
vendor.display.enable_dpps_dynamic_fps=1
vendor.display.enable_early_wakeup=1
vendor.display.enable_hdr10_gpu_target=1
vendor.display.enable_optimize_refresh=0
vendor.display.enable_rc_support=1

# Audio
# The whole PAL/AGM/HAL implementation went back to blobs (see the "Audio HAL"
# section of device.mk); these are the switches those binaries read at runtime.
# vendor.audio.hal.aidl.enabled matters most: stock takes the AIDL audio HAL
# path.
aaudio.hw_burst_min_usec=2000
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
ro.audio.flinger_standbytime_ms=2000
vendor.audio.adm.buffering.ms=2
vendor.audio.c2.preferred=true
vendor.audio.compress_capture.aac=true
vendor.audio.compress_capture.enabled=true
vendor.audio.feature.a2dp_offload.enable=true
vendor.audio.feature.battery_listener.enable=true
vendor.audio.feature.dmabuf.cma.memory.enable=false
vendor.audio.feature.hfp.enable=true
vendor.audio.feature.kpi_optimize.enable=true
vendor.audio.flac.sw.decoder.24bit=true
vendor.audio.hal.aidl.enabled=true
vendor.audio.hal.output.suspend.supported=true
vendor.audio.hdr.record.enable=false
vendor.audio.hdr.spf.record.enable=false
vendor.audio.hw.aac.encoder=false
vendor.audio.offload.buffer.size.kb=32
vendor.audio.offload.multiple.enabled=false
vendor.audio.offload.track.enable=true
vendor.audio.ull_record_period_multiplier=2
vendor.audio.use.sw.alac.decoder=true
vendor.audio.use.sw.ape.decoder=true
vendor.audio.use.sw.mpegh.decoder=true
vendor.audio.volume.headset.gain.depcal=true
vendor.audio_hal.period_size=192
vendor.audio_hal.timecheck_timeoutMS=8000
vendor.qc2audio.per_frame.flac.dec.enabled=true
vendor.qc2audio.suspend.enabled=true

# ⚠️ ro.vendor.dolby.dax.version was here and is gone with Dolby Atmos.
# It had ZERO readers even before the removal: a binary-safe scan of the
# whole blob set finds the string in no ELF and no config, only in
# build.prop itself. It was stock parity and nothing more.

# Bluetooth
# a2dp_offload.cap is a capability list; the Bluetooth stack uses it to decide
# which codecs are offloaded to the DSP.
ro.bluetooth.a2dp_offload.supported=true
persist.bluetooth.a2dp_offload.cap=sbc-aac-aptx-aptxhd-ldac
persist.bluetooth.a2dp_offload.disabled=false
persist.bluetooth.leaudio_offload.disabled=false
# ⚠️ persist.vendor.bt.a2dp_offload_cap was here. Removed in session 12: it has
# NO reader. `grep -rlaF` over every partition of both the built image and the
# factory image finds the string only inside vendor/build.prop itself — Lenovo
# sets it and nothing consumes it either. The live capability list is
# persist.bluetooth.a2dp_offload.cap above, which the AOSP stack does read.
# It was also the FIRST SELinux denial of every boot (audit(0.0:3)): QTI labels
# the prefix persist.vendor.bt.a2dp as bluetooth_prop
# (device/qcom/sepolicy/generic/private/property_contexts:47), a system_ext type
# vendor_init may not set. Deleting a dead property is the right fix; granting
# vendor_init write access to bluetooth_prop to set something nobody reads is not.
persist.vendor.bt.aac_frm_ctl.enabled=true
persist.vendor.bt.aac_vbr_frm_ctl.enabled=true
persist.vendor.qcom.bluetooth.aac_vbr_ctl.enabled=true
persist.vendor.qcom.bluetooth.aptxadaptiver2_1_support=true
persist.vendor.qcom.bluetooth.dualmode_transport_support=true
persist.vendor.qcom.bluetooth.lossless_aptx_adaptive_le.enabled=true
persist.vendor.qti.btadvaudio.target.support.xpan=true
ro.vendor.bluetooth.btconfigstore=false
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.bap.broadcast.assist.enabled=true
bluetooth.profile.bap.broadcast.source.enabled=true
bluetooth.profile.bap.unicast.client.enabled=true
bluetooth.profile.ccp.server.enabled=true
bluetooth.profile.csip.set_coordinator.enabled=true
bluetooth.profile.hap.client.enabled=true
bluetooth.profile.mcp.server.enabled=true
bluetooth.profile.vcp.controller.enabled=true

# Camera
ro.camera.disableHeicUltraHDR=true
ro.camera.enableCamera1MaxZsl=1

# Codecs / media
media.c2.hal.selection=aidl
debug.c2.use_dmabufheaps=1
debug.stagefright.c2inputsurface=-1
debug.stagefright.ccodec=4
debug.stagefright.omx_default_rank=0
# ro.mediaserver.64b.enable is deliberately absent. It was the only property in
# the whole built vendor/build.prop with no property_contexts entry, so it fell
# through to the "*" catch-all -> default_prop. /vendor/build.prop is loaded with
# kVendorContext (property_service.cpp:716-724) and every key goes through
# CheckPermissions, and system/sepolicy/private/property.te:793-796 is
#   neverallow { domain -init } default_prop:property_service set;
# so no rule could ever be written for it — vendor_init is permanently barred.
# Stock worked around this by patching the *platform* file
# (plat_property_contexts:1733 labels it vendor_medsrv_set_64b), which is not
# something a device tree can do. Android 16 has no mediaserver anyway, so the
# property is dead: dropping it is strictly better than shipping a guaranteed
# "failed to set property" on every boot.
drm.service.enabled=true

# Perf
# ro.vendor.extension_library tells the framework which library to dlopen for
# Qualcomm's perf extension. Without it the whole libqti-perfd-client boost-hint
# path does nothing.
ro.vendor.extension_library=libqti-perfd-client.so
ro.vendor.perf-hal.ver=3.0
ro.vendor.perf.scroll_opt=1
ro.vendor.qspm.enable=true

# Storage / USB / other board-level
ro.frp.pst=/dev/block/bootdevice/by-name/frp
# ★ Without this the Developer Options "OEM unlocking" toggle does not exist.
#
# OemUnlockPreferenceController.java:66-72 reads ro.oem_unlock_supported with a
# default of UNSUPPORTED ("-9999"); on anything but "1" it leaves mOemLockManager
# null, and isAvailable() (:80-82) then returns false and the whole preference is
# hidden. Measured session 23: `getprop ro.oem_unlock_supported` was empty on this
# build and stock sets it to 1 (work/unpacked/parts/vendor/build.prop:154).
#
# The rest of the machinery is already here — ro.frp.pst is set one line up and
# /dev/block/bootdevice/by-name/frp exists — so this was the only missing piece.
# It matters even though this unit is already unlocked: the toggle is what has to
# be on BEFORE a `fastboot flashing unlock`, so a device that is ever relocked
# would have no way back without it.
#
# Lands on vendor, same partition as stock. Label check: it falls to
# vendor_default_prop by longest prefix, which vendor_init may already set, so no
# new sepolicy.
ro.oem_unlock_supported=1
ro.crypto.metadata_init_delete_all_keys.enabled=true
# ⚠️ external_storage.{casefold,projid,sdcardfs}.enabled used to be set here and are
# gone on purpose. device.mk:43 inherits emulated_storage.mk, which puts the same
# three into PRODUCT_VENDOR_PROPERTIES (build/make/target/product/emulated_storage.mk
# :19,23,25) — i.e. onto this same partition, with the same values. It built only
# because post_process_props.py:113-117 tolerates a duplicate when every value
# agrees; the day AOSP changes one of the three the build stops with "found
# duplicate sysprop assignments". Same hazard already documented for
# ro.hwui.use_vulkan and ro.bionic.cpu_variant in this file.
ro.usb.uvc.enabled=true
sys.usb.mtp.batchcancel=1

# USB gadget. Without these there is no ADB, no MTP and no tethering on first
# boot -- i.e. no way to debug anything else.
#
# vendor/etc/init/hw/init.qcom.usb.rc (a blob) only ever READS these:
#
#     setprop sys.usb.controller ${vendor.usb.controller}
#     wait /sys/class/udc/${sys.usb.controller}
#
# Nothing in any .rc on the vendor partition ever setprop's them -- on the
# factory image they come solely from vendor/build.prop.
#
# Upstream normally gets them from vendor/qcom/opensource/usb/vendor_product.mk,
# which this tree does NOT inherit. Do not simply inherit it either: its
# vendor.usb.diag.func.name branches on TARGET_HAS_DIAG_ROUTER, which is unset
# here, so it would emit `diag` where the factory uses `ffs`.
#
# Values are the factory vendor/build.prop verbatim. Note that on a running
# device `getprop` shows rmnet/rndis for the two *.func.name entries rather than
# gsi -- init rewrites those per USB composition at runtime. gsi is the correct
# boot-time default; do not "fix" them to match a live getprop.
vendor.usb.controller=a600000.dwc3
vendor.usb.use_gadget_hal=1
vendor.usb.use_ffs_mtp=1
vendor.usb.diag.func.name=ffs
vendor.usb.dpl.inst.name=dpl
vendor.usb.qdss.inst.name=qdss_sw
vendor.usb.rmnet.func.name=gsi
vendor.usb.rmnet.inst.name=rmnet
vendor.usb.rndis.func.name=gsi

# Pin the vendor API level to what the vendor blobs actually are (Android 15).
#
# board_config.mk:1033-1038 defaults BOARD_API_LEVEL to RELEASE_BOARD_API_LEVEL,
# which is 202504 on bp2a, and sysprop_config.mk:104-106 emits
# `ro.board.api_level?=202504`. init then computes
# ro.vendor.api_level = min(vendorApiLevelOf(first_api_level), board_api_level)
# = 202504 (property_service.cpp:1075-1101).
#
# At >202404, service_parser.cpp:679-693 turns "service block with no user" into
# a hard parse error. 19 of the 270 service blocks in the extracted vendor .rc
# files declare no user (vendor.qms, vendor.dpmd, vendor.ssr_setup,
# vendor.power_off_alarm, qlogd, dhcpcd_wlan0, ...), so all 19 would silently
# fail to be defined.
#
# The property is emitted with ?=, so a plain assignment here wins.
# validate_grf_props only requires board_api_level >= board_first_api_level
# (202404 >= 202404). The live device reports 202404.
ro.board.api_level=202404

# ⚠️ sys.vendor.shutdown.waittime=500 used to be here and is deliberately gone.
# It is the ONLY property in this file that vendor_init cannot set: sys.vendor.
# has no vendor property_contexts entry, so it lands on system_prop, and
# system/sepolicy/private/property.te's neverallow blocks granting any non-core
# domain set access to it. So every enforcing boot logged one denial and the
# property stayed unset. It also has zero consumers -- a byte-safe scan of the
# whole factory image finds it only in build.prop itself. Same class as the
# ro.mediaserver.64b.enable entry removed earlier.
ro.hardware.keystore_desede=true
ro.soc.manufacturer=QTI
ro.soc.model=SM8735P
wifi.aware.interface=wifi-aware0

# ── Display / gralloc tunables the diff missed ────────────────────────────────
#
# The 22 vendor.display.* keys above were carried over; these were not, because
# the upstream source of the whole group is
# hardware/qcom-caf/sm8750/display/hal/config/display-product.mk:59-100, and
# device.mk does not inherit that file. Picked one by one rather than inheriting
# it wholesale — that mk also sets things this device does not want.
#
# Each one below was kept only after confirming a consumer is actually installed
# in our vendor image (binary-safe grep over vendor/lib64 and vendor/bin):
#   enable_rounded_corner   -> libsdmclient.so, libsdmcore.so
#   use_smooth_motion       -> init.qti.display_boot.sh
#   svi.config{,_path}      -> libdpps.so   (we already ship the referenced
#                              vendor/etc/display/SVIConfig.xml and already set
#                              ro.vendor.display.svi=1, so the HAL was being told
#                              the feature exists while never being told where
#                              its config lives)
#   gralloc.disable_ubwc    -> libsdmclient.so, libsdmutils.so
#   gralloc.enable_logs     -> libgrallocutils.so, libgralloccore.so
#
# Deliberately NOT carried, having checked:
#   vendor.display.vds_allow_hwc   — no installed binary reads it
#   vendor.display.svi_threshold_nits — likewise
#   vendor.gralloc.enable_snapalloc — init.qti.display_boot.sh:93 sets it at
#                                     runtime for soc_id 694; a static value
#                                     here would be redundant at best
vendor.display.enable_rounded_corner=1
vendor.display.use_smooth_motion=1
vendor.display.svi.config=1
vendor.display.svi.config_path=/vendor/etc/display/SVIConfig.xml
vendor.gralloc.disable_ubwc=0
vendor.gralloc.enable_logs=0

# Updatable GPU driver package. We install the APK
# (vendor/app/com.qualcomm.qti.gpudrivers.sun.api35, confirmed in the build),
# but without this property libEGL_adreno.so / vulkan.adreno.so never look for
# it and the prebuilt-driver path goes unused. Both binaries reference the
# property name directly.
ro.gfx.driver.1=com.qualcomm.qti.gpudrivers.sun.api35

# KeyMint retry backoff, read by libkeymasterdeviceutils.so (installed).
vendor.keymint.retry_timer=5

# Widevine OEMCrypto tuning, read by liboemcrypto.so (installed). Stock values.
vendor.wv.oemcrypto.debug.enable_external_display_check=false
vendor.wv.oemcrypto.debug.enable_hlos_data_path=true
vendor.wv.oemcrypto.debug.enable_prov40=true

# ★ Without this line the device has no gatekeeper and no lockscreen credential.
#
# vendor/etc/init/android.hardware.gatekeeper-service-qti.rc (a blob) declares
# vendor.gatekeeper_default as `disabled` and enables it from exactly one place:
#
#     on property:vendor.gatekeeper.is_security_level_spu=0
#         enable vendor.gatekeeper_default
#
# On stock that property is set by /vendor/bin/init.qti.keymaster.sh, which is
# exec'd from android.hardware.gatekeeper-service-spu-qti.rc. We deliberately do
# NOT extract that .rc -- it declares a second service whose binary
# (android.hardware.gatekeeper-service-spu-qti) we do not ship, so init would
# restart-loop it forever. So nothing sets the property and the HAL never starts.
#
# That alone would be a missing HAL. What makes it worse is that
# configs/hidl/manifest.xml DOES declare android.hardware.gatekeeper, so
# gatekeeperd takes the isDeclared branch:
#
#     system/core/gatekeeperd/gatekeeperd.cpp:116-117
#         if (AServiceManager_isDeclared(gatekeeperServiceName))
#             ndk::SpAIBinder ks2Binder(AServiceManager_waitForService(...));
#
# waitForService blocks forever, and main.cpp:36-38 runs that constructor BEFORE
# addService -- so android.service.gatekeeper.IGateKeeperService is never
# registered at all and LockSettingsService gets null.
#
# The value is not a guess: init.qti.keymaster.sh branches on
# /sys/devices/soc0/soc_id and sets 1 only for {618, 639, 705, 706} (SM8750).
# This device is soc_id 694, so it takes the else branch -> 0. Stock confirms
# `[vendor.gatekeeper.is_security_level_spu]: [0]` with the HAL running.
#
# KeyMint is NOT affected: its .rc starts unconditionally from `on init`.
vendor.gatekeeper.is_security_level_spu=0

# ── Values present in the factory vendor/build.prop that this tree was missing ─
#
# Found by diffing our 195 props against the factory build.prop set. Only the
# ones with a statable purpose are taken; the rest are listed below as skipped,
# with the reason, so the next session does not re-litigate the same list.
#
# ⚠️ Method note, because it bit me: "grep the built images for the property
# name" is NOT a valid way to prove a property has no consumer. Most of these
# are read from dex inside a compressed .apk/.jar, or by native code that
# assembles the string at runtime. That grep reports "no consumer" even for
# ro.vendor.qti.va_odm.support, which this tree already ships deliberately.
# Positive evidence of harm is actionable; absence of a grep hit is not.

# Frame pacing in the QTI perf stack. Factory vendor/build.prop sets it, and
# this is a 144 Hz panel where pacing is exactly what it is for.
vendor.perf.framepacing.enable=1

# Wi-Fi only tablet with no modem: there is no SIM for Keyguard to require.
keyguard.no_require_sim=true

# Incremental FS, used by Play Store streamed installs. Not a blind copy: the
# kernel really supports it -- CONFIG_INCREMENTAL_FS=y in the running stock
# kernel's own config (work/device_dump/root/kernel/config.gz).
ro.incremental.enable=yes

# AVF: remote attestation off. The hypervisor here is Gunyah, not KVM —
# /dev/kvm does not exist (work/device_dump/root/avf/kvm.txt) and `vm info`
# reports "Only protected VMs are supported" — so say this explicitly rather
# than leaving it to a default.
#
# ⚠️ This comment used to add "and PRODUCT_AVF_ENABLED is off". That was FALSE.
# device.mk:62 inherits packages/modules/Virtualization/apex/product_packages.mk,
# whose line 45 is `PRODUCT_AVF_ENABLED := true`, and it takes effect —
# out/soong/soong.custom_malbec.variables records "avf_enabled": "true".
#
# It is left ON deliberately, because the shipped result matches the factory ROM
# exactly, which is the parity we want:
#   system/apex/com.android.virt.apex   ours 94.9 MB / factory 87.8 MB (both full)
#   ro.config.isolated_compilation_enabled=true   set by both
#   com.android.compos                  shipped by NEITHER
#   VmTerminalApp                       shipped by NEITHER (this is the one that
#                                       would actually fail: its Debian guest is
#                                       an unprotected VM, which this hypervisor
#                                       refuses)
# Turning PRODUCT_AVF_ENABLED off would ship a *stub* virt apex the factory does
# not ship, while isolated_compilation_enabled=true stayed pointing at a CompOS
# that is not there. Do not "fix" it.
avf.remote_attestation.enabled=false

# Userspace thermal mitigation. Without this line the entire subsystem is dead.
#
# init.qcom.rc:517 defines the real daemon as
#     service thermal-switch-engine /vendor/bin/thermal-engine-v2 \
#             -c /vendor/etc/thermal-engine-malbec-${vendor.thermal.mode}.conf
# and :524 gates it on `on property:vendor.thermal.mode=*`. The plain
# `thermal-engine` service is *supposed* to exit -- thermal-engine-v2's only
# config-path string is /vendor/etc/thermal-engine.conf, and it prints
# "No platform thermal config file, exiting" when that is the only one it gets.
# That message appeared 249 times in the first boot capture and looked like a
# missing blob; it is not. The file is byte-identical to the factory's.
#
# On stock the property is set by Lenovo's ZUI framework code on system_ext
# (system_ext_sepolicy.cil:1956 grants system_server set on vendor_thermal_prop,
# and system_ext_property_contexts:156 labels it). PixelOS replaces that
# partition, so nothing ever set it, so thermal-switch-engine never started and
# none of the seven thermal-engine-malbec-{normal,game,camera,audio,floating,
# skynet,off}.conf policies were ever loaded -- all seven ship in our image.
#
# Consequence measured on the first boot: android.hardware.thermal-service.qti
# reported "sensor: cpu-1-4-0 temperature: 105.1 ... new: 3" to a framework
# with no daemon behind it to act on the throttle level. Kernel LMH/BCL still
# work, so the tablet was never at risk, but sustained-load and charge-current
# mitigation were absent.
#
# `normal` is what stock reports (work/stock-harvest/*/getprop-all).
#
# Setting it here rather than from an init action is deliberate: properties
# loaded from build.prop are in place before init runs queue_property_triggers,
# which happens after wait_for_coldboot_done, so /sys/class/thermal is populated
# by the time the trigger fires. An `on property:sys.boot_completed=1` action
# would also work but would leave the device unmitigated for the whole boot.
vendor.thermal.mode=normal

# Deliberately NOT taken from the factory build.prop, each for a specific reason:
#
#   persist.vendor.qcomsysd.enabled=1
#       init.qcom.rc:452 does `enable qcomsysd` when this is 1 AND the build is
#       userdebug -- which ours is. qcomsysd runs /system/vendor/bin/
#       qcom-system-daemon, and we do not extract that binary. Setting this
#       would hand init a service it can never start.
#
#   ro.recovery.usb.{vid,adb.pid,fastboot.pid}
#       Already present in our build with the identical factory values
#       (18D1/D001/4EE0 -- Google's USB VID, an AOSP default, not a Lenovo one).
#       Verified in out/.../vendor/build.prop and in our recovery prop.default.
#
#   vendor.gatekeeper.disable_spu=true
#       No consumer anywhere. A binary-safe search of both the factory images
#       and ours finds it only in vendor_property_contexts (a label) and in the
#       factory build.prop (the value). It is not the other half of
#       vendor.gatekeeper.is_security_level_spu above -- that one has a real,
#       documented consumer chain; this one has none.
#
#   ro.vendor.vm.ssr.enable=false
#       A no-op here. init.target.rc:134-144 has three branches -- empty, false
#       and true -- and the empty and false branches do exactly the same thing.
#       So setting false is indistinguishable from leaving it unset.
#       (Separately: all three branches start vendor.qvirtservice_rs, which this
#       tree neither defines nor ships. Expected boot noise, see
#       work/analysis/FIRST-BOOT-TRIAGE.md.)
#
#   persist.sys.sf.color_saturation=1.0 / persist.sys.sf.color_mode=0
#       persist.* user settings whose values equal SurfaceFlinger's own
#       defaults, so writing them changes nothing and only adds a line the next
#       reader has to evaluate.
#
#   debug.mdpcomp.logs=0 / persist.demo.hdmirotationlock=false
#       Debug and demo-mode knobs at their default values.
